msgid "Aucune commande reçue sur cette période (avec ces filtres)."
msgstr "لا توجد طلبات مستلمة في هذه الفترة (مع هذه التصفيات)."

#: includes/class-aod-cd-section-home.php:2058
msgid "Commandes reçues"
msgstr "الطلبات المستلمة"

#: includes/class-aod-cd-section-home.php:2059
