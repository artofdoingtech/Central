msgstr "الطلبات المستلمة (المتجر)"

#: includes/class-aod-cd-section-home.php:2066
#: includes/class-aod-cd-section-home.php:2152
#: includes/class-aod-cd-section-orders.php:103
msgid "Confirmées"
msgstr "مؤكَّدة"

#: includes/class-aod-cd-section-home.php:2067
msgid "Délai moyen de confirmation"
msgstr "متوسط مدة التأكيد"

#: includes/class-aod-cd-section-home.php:2070
